generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  PREMIUM
}

enum Subject {
  GERAL
  MATEMATICA
  PORTUGUES
  FISICA
  QUIMICA
  BIOLOGIA
  FILOSOFIA
  SOCIOLOGIA
  TECNOLOGIA
  INGLES
  ESPANHOL
  HISTORIA
  GEOGRAFIA
}


model Simulation {
  id              String   @id @default(uuid()) 
  publicId        String   @unique
  title           String
  description     String?
  published       Boolean  @default(false)
  createdAt       DateTime @default(now()) 
  updatedAt       DateTime @updatedAt 
  durationMinutes Int 
  requiredPlan Plan @default(FREE)
  subject Subject @default(GERAL)
}

/**
 * npx prisma validate      → confere se o schema está válido
 * npx prisma format        → organiza o schema.prisma
 * npx prisma migrate dev   → cria/atualiza tabelas no banco com histórico
 * npx prisma generate      → gera o client usado pelo backend
 * npx prisma studio        → abre painel visual do banco
 * npx prisma db push       → empurra schema para banco sem migration
 * npx prisma db pull       → puxa banco existente para o schema
 */
